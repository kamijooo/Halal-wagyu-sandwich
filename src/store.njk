---
pagination:
  data: stores.stores
  size: 1
  alias: store
permalink: "/{{ store.region }}/{{ store.slug }}/index.html"
eleventyComputed:
  title: "{{ store.name_full }}"
---
<!DOCTYPE html>
<html lang="en">
<head>
<!-- Google Tag Manager -->
<script>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({
    store_name: '{{ store.slug }}',
    store_area: '{{ store.region }}',
    brand: 'sandwich',
    channel: 'default'
